{
  "name": "cocoloco-live-manager-v2",
  "private": true,
  "version": "2.0.0-transport",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node bridge/server.js\" \"node overlay-sync/server.js\"",
    "vite": "vite",
    "bridge": "node bridge/server.js",
    "overlay-sync": "node overlay-sync/server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import ./tests/nodeTestSetup.js --experimental-loader ./tests/resolve-loader.mjs --test",
    "v2:build": "vite build",
    "v2:serve": "node bridge/liveTransportServerV2.js",
    "v2:live": "npm run v2:build && node bridge/liveTransportServerV2.js"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1"
  }
}
